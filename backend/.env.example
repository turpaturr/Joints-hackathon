# Environment Variables
PROJECT_NAME="Connect Backend API"
DEBUG=True
API_V1_STR=/api

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=connect_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/connect_db

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
